# Copy to `.env.dev` and fill in. Most values are generated by the
# Microsoft 365 Agents Toolkit during provision.

TEAMSFX_ENV=dev
APP_NAME_SUFFIX=dev

# Generated during provision
TEAMS_APP_ID=
M365_TITLE_ID=
M365_APP_ID=

# Written by the oauth/register step, referenced by ai-plugin-github.json
GITHUB_AUTH_ID=

TEAMS_APP_TENANT_ID=<your-entra-tenant-id>
