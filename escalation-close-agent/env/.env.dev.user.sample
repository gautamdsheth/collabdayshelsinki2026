# Copy to `.env.dev.user` and fill in. NEVER commit `.env.dev.user`.
# Keys prefixed with SECRET_ are masked in Microsoft 365 Agents Toolkit logs.

# GitHub App Client ID (starts with Iv23...), from the App's settings page.
# NOT the numeric App ID, and not the private key.
GITHUB_CLIENT_ID=<github-app-client-id>
SECRET_GITHUB_CLIENT_SECRET=<github-app-client-secret>
