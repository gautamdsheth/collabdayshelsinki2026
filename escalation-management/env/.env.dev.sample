# Copy to `.env.dev` and fill in. Values are generated by the
# Microsoft 365 Agents Toolkit during provision — you normally do not
# hand-edit these apart from the tenant ID.

TEAMSFX_ENV=dev
APP_NAME_SUFFIX=dev

# Generated during provision
TEAMS_APP_ID=
M365_TITLE_ID=
M365_APP_ID=

# Base64 of "<tenant-id>##<mcp-auth-object-id>" — emitted during provision
MCP_DA_AUTH_ID=

TEAMS_APP_TENANT_ID=<your-entra-tenant-id>
